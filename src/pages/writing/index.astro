---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getWritingEntries } from '../../lib/writing';
const entries = await getWritingEntries();
---
<BaseLayout title="Writing" description="Articles and reflections on research and ideas.">
  <h1>Writing</h1>
  <p>Articles and reflections, including ideas developed through conversations with AI.</p>
  {entries.length === 0 ? <p>No articles published yet.</p> : (
    <ul>
      {entries.map((entry) => (
        <li>
          <h2><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h2>
          <p class="metadata"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>{entry.data.draft && ' · Draft'}</p>
          <p>{entry.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
