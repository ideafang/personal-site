---
interface Props { title: string; description?: string; }
const { title, description = 'Personal introduction, research, and writing.' } = Astro.props;
const navigation = [ ['/', 'Home'], ['/research/', 'Research'], ['/writing/', 'Writing'], ['/about/', 'About'] ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Personal Homepage</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a href="/">Personal Homepage</a>
      <nav aria-label="Main navigation">
        {navigation.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer><p>Personal introduction · Research · Writing</p></footer>
  </body>
</html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #20252b; background: #fff; line-height: 1.65; }
  body { max-width: 48rem; margin: auto; padding: 1.5rem; }
  header { padding-bottom: 1rem; border-bottom: 1px solid #ddd; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .75rem; }
  a { color: #185c91; text-underline-offset: .2em; }
  a[aria-current="page"] { font-weight: bold; }
  main { padding: 2rem 0; min-height: 50vh; }
  h1, h2, h3 { line-height: 1.3; }
  img { max-width: 100%; height: auto; }
  pre { overflow-x: auto; padding: 1rem; }
  footer { border-top: 1px solid #ddd; color: #535b63; }
  .skip-link { position: absolute; left: -10000px; }
  .skip-link:focus { position: static; }
  .metadata { color: #535b63; }
</style>
